set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR riscv64)

if(NOT DEFINED ENV{RISCV_CLANG} OR "$ENV{RISCV_CLANG}" STREQUAL "")
  message(FATAL_ERROR
          "RISCV_CLANG must point to a Clang compiler with Zvmatch support")
endif()

if(NOT DEFINED ENV{RISCV_SYSROOT} OR "$ENV{RISCV_SYSROOT}" STREQUAL "")
  message(FATAL_ERROR
          "RISCV_SYSROOT must point to a RISC-V Linux sysroot")
endif()

set(CMAKE_C_COMPILER "$ENV{RISCV_CLANG}" CACHE FILEPATH "")
set(CMAKE_C_COMPILER_TARGET riscv64-unknown-linux-gnu CACHE STRING "")
set(CMAKE_SYSROOT "$ENV{RISCV_SYSROOT}" CACHE PATH "")

if(DEFINED ENV{RISCV_GCC_TOOLCHAIN} AND
   NOT "$ENV{RISCV_GCC_TOOLCHAIN}" STREQUAL "")
  set(CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN
      "$ENV{RISCV_GCC_TOOLCHAIN}" CACHE PATH "")
endif()

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
